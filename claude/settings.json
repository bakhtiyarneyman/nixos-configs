{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/etc/nixos/claude-notify-stop"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/etc/nixos/claude-notify-permission"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "effortLevel": "high",
  "voiceEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 4102444800000
  },
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Read(/tmp/**)",
      "Write(/tmp/**)",
      "Edit(/tmp/**)"
    ]
  }
}
