#!/usr/bin/env fish

source /etc/nixos/claude-notify.fish

# Native Stop hooks receive JSON on stdin and do not run for internal title/recap turns.
set text (jq -r \
    'select(.hook_event_name == "Stop") | .last_assistant_message // empty' \
    | string collect)
send_completion_notification Codex "$text"
printf '{}\n'
